# Application
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/fooddash

# JWT
JWT_SECRET=fooddash-dev-secret-key

# Backblaze B2 (S3-compatible) — requis pour /api/upload
# Créez un bucket sur https://www.backblaze.com/b2/cloud-storage.html
# puis une clé d'application (Application Keys) avec accès au bucket.
B2_BUCKET_NAME=Delevery
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=your-b2-key-id
B2_APP_KEY=your-b2-application-key

# URL publique de l'API (pour les liens d'images en stockage local)
# PUBLIC_BASE_URL=http://localhost:5000
